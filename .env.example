# NFT / collection stats
GRAVEMARKET_API_KEY=
HELIUS_API_KEY=

# Unified Neon DB — auth, wallets, merch, casino, cashout
POSTGRES_URL=
# Casino Postgres (same DB as hub; POSTGRES_URL is used if CASINO_DATABASE_URL is unset)
CASINO_DATABASE_URL=

# Auth.js — Discord login (required for Holder Hub)
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Hub Discord roles — read member roles for display (separate from GraveKeeper verify bot)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=948253353907986442
# Slash commands — Interactions Endpoint (see docs/discord-slash-commands.md)
DISCORD_PUBLIC_KEY=
# Optional: comma-separated role IDs for admin /profile and /addclaim
DISCORD_ADMIN_ROLE_IDS=
# Announcements channel for reaction rewards (default: BUXDAO announcements)
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=948254981327290408
# NFT activity alerts (list, delist, sale, transfer, burn)
DISCORD_ACTIVITY_CHANNEL_ID=1097864119849320469
# Helius enhanced webhook auth (sent as Authorization header on deliveries)
HELIUS_WEBHOOK_SECRET=
# GraveMarket activity sync: external cron every 2 min →
# GET https://www.buxdao.com/api/nft-activity/gravemarket-sync?key=<HOLDER_REWARDS_CRON_SECRET>
# X linking (optional — Holder Hub step 2)
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
# Optional; Auth.js auto-detects on Vercel
# AUTH_URL=https://buxdao.com

# Merch store (Printful + SOL checkout)
PRINTFUL_API_KEY=
# Server-side Solana RPC (QuickNode, Helius, etc.). Browser wallets use /api/solana/rpc proxy.
# On Vercel: set this to your QuickNode URL (same endpoint you may have used for NEXT_PUBLIC_SOLANA_RPC_URL).
SOLANA_RPC_URL=
# Optional legacy name — server proxy can still read this if SOLANA_RPC_URL is unset.
# NEXT_PUBLIC_SOLANA_RPC_URL=
# Canonical site URL for metadata (favicon, OG). Defaults to Vercel URL or localhost.
# NEXT_PUBLIC_SITE_URL=https://buxdao.com

# Casino games (BUX token)
BUX_TOKEN_MINT=
BUX_TOKEN_DECIMALS=9
# Set true/1 to pause spins and withdrawals while investigating issues
# CASINO_PAUSED=false
# Casino BUX pool — receives spin/chip purchases and pays prize collects
TREASURY_WALLET=
TREASURY_PRIVATE_KEY=
# Main ops wallet — receives SOL protocol fees (not BUX)
PROJECT_WALLET=
NEXT_PUBLIC_PROJECT_WALLET=
# Purchase SOL fee split (default 0.002 total: 0.0015 project + 0.0005 treasury gas)
CASINO_PURCHASE_FEE_LAMPORTS=2000000
CASINO_FEE_TO_PROJECT_LAMPORTS=1500000
CASINO_FEE_TO_TREASURY_GAS_LAMPORTS=500000

# Holder daily rewards (parallel to GraveStake; ON HOLD — see docs/holder-daily-rewards.md)
HOLDER_REWARDS_ENABLED=false
# Accrual runs via GitHub Actions (.github/workflows/holder-rewards-accrue.yml)
# Required repo secrets: POSTGRES_URL, HELIUS_API_KEY
# Discord engagement sync: external cron (e.g. cron-job.org every 5 min) hits
# GET https://www.buxdao.com/api/holder-rewards/discord-engagement/sync with Authorization: Bearer <secret>
HOLDER_REWARDS_CRON_SECRET=
# SOL platform fee per claim (default 0.0005)
HOLDER_REWARDS_CLAIM_FEE_LAMPORTS=500000
